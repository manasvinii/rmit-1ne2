# Copy to backend/.env and fill in. Never commit the real .env.
APP_ENV=development

# Session JWT signing key and Fernet key for Canvas tokens at rest. Required in production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
FERNET_KEY=
JWT_TTL_MINUTES=720

CORS_ORIGINS=http://localhost:4200,http://localhost:4300
PUBLIC_BASE_URL=http://localhost:8010
SIGNED_URL_TTL_SECONDS=3600

# Legacy academic tables (User / Courses / Assignments / Course_timetable) on Supabase REST.
# Leave empty to use the local SQLite copy of those tables.
SUPABASE_URL=
SUPABASE_KEY=

# Lecture knowledge store. Empty -> SQLite at SQLITE_PATH (default backend/data/rmit1ne.db).
# postgresql://... -> Postgres + pgvector (run migrations/postgres/*.sql; needs CREATE EXTENSION vector).
DATABASE_URL=
SQLITE_PATH=

CANVAS_BASE_URL=https://rmit.instructure.com
# Optional: existing n8n workflow for structured questions (receives user_id + query)
N8N_WEBHOOK_URL=

# Embeddings: fastembed (local, default) | openai | hash (tests only)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Optional LLM (any OpenAI-compatible endpoint). Without it, answers are extractive and the
# knowledge graph uses heuristic extraction only.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

WHISPER_MODEL=base.en
# Folder the /ingestion/local endpoint may read from (paths outside it are rejected)
LOCAL_CONTENT_DIR=
MAX_PDF_MB=100
MAX_VIDEO_MB=2048

# Pupil demo: "Continue with Canvas" signs in as this existing student (ignored when APP_ENV=production)
DEMO_USER_EMAIL=
# Force the current teaching week for demos (otherwise counted from the course start date)
CURRENT_WEEK=
